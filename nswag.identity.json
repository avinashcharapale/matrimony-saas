{
  "$schema": "https://raw.githubusercontent.com/NSwag/NSwag/master/src/NSwag.Core/JsonSchemas/NJsonSchema.json",
  "runtime": "Net100",
  "command": "openapi2tsclient",
  "input": "tmp/identity-swagger.json",
  "output": "libs/generated/src/_raw/identity.ts",
  "typescriptGeneratorSettings": {
    "template": "Angular",
    "useBaseUrl": false,
    "injectHttpClient": true,
    "generateResponseClasses": false,
    "useSingletonServices": true,
    "exportTypes": true,
    "typeStyle": "Interface",
    "operationNameGenerator": "OpenApi",
    "generateDefaultValues": true
  }
}
