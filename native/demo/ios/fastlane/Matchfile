# Fastlane Matchfile for iOS
# Certificate and provisioning profile management

# Git repository for storing certificates and profiles
# git_url "https://github.com/your-org/certificates.git"

# Type of certificates to manage
# type "appstore"  # Options: development, adhoc, appstore, enterprise

# App identifiers
# app_identifier ["com.matrimony.saas"]

# Team ID
# team_id ENV['APPLE_TEAM_ID']

# Storage mode (git or google_cloud or s3)
# storage_mode "git"

# Readonly mode (for CI)
# readonly true

# Generate new certificates if needed
# generate_apple_certs true

# Force renewal
# force false

# API Key for App Store Connect (for match)
# api_key_path ENV['APP_STORE_CONNECT_API_KEY_PATH']
# api_key ENV['APP_STORE_CONNECT_API_KEY_BASE64']
# api_key_id ENV['APP_STORE_CONNECT_API_KEY_ID']
# api_issuer ENV['APP_STORE_CONNECT_API_ISSUER_ID']