// Release.xcconfig - Manual signing configuration for App Store distribution
// Set these values in CI/CD environment variables or via Fastlane Match

// Team ID from Apple Developer Portal
DEVELOPMENT_TEAM = $(APPLE_TEAM_ID)

// Manual signing for release builds
CODE_SIGN_STYLE = Manual
PROVISIONING_PROFILE_SPECIFIER = $(APP_STORE_PROVISIONING_PROFILE_NAME)
CODE_SIGN_IDENTITY = Apple Distribution

// Build settings
SWIFT_VERSION = 5.0
IPHONEOS_DEPLOYMENT_TARGET = 16.0
MARKETING_VERSION = $(MARKETING_VERSION)
CURRENT_PROJECT_VERSION = $(CURRENT_PROJECT_VERSION)

// App-specific settings
APP_DISPLAY_NAME = $(APP_DISPLAY_NAME)
TENANT_ID = $(TENANT_ID)
API_DOMAIN = $(API_DOMAIN)
ASSOCIATED_DOMAIN = $(ASSOCIATED_DOMAIN)

// Optimization
SWIFT_OPTIMIZATION_LEVEL = -O
ENABLE_BITCODE = NO
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = all
DEPLOYMENT_POSTPROCESSING = YES
SEPARATE_STRIP = YES
COPY_PHASE_STRIP = YES

// Security
ENABLE_HARDENED_RUNTIME = YES
OTHER_LDFLAGS = $(inherited) -ObjC

// Code signing entitlements
CODE_SIGN_ENTITLEMENTS = App/App.entitlements